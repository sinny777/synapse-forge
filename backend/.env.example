# NeuralToolRouter Environment Variables
# Copy this file to .env and fill in your API keys
# Reference: https://docs.litellm.ai/docs/provider_registration/

# ============================================================================
# LLM Provider API Keys and Configuration
# ============================================================================

# --- Ollama (Local Models) ---
# Default: http://localhost:11434
# Documentation: https://docs.litellm.ai/docs/providers/ollama
OLLAMA_API_BASE=http://localhost:11434

# --- OpenAI ---
# Get your key from: https://platform.openai.com/api-keys
# Documentation: https://docs.litellm.ai/docs/providers/openai
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_ORGANIZATION=your-org-id

# --- Anthropic (Claude) ---
# Get your key from: https://console.anthropic.com/
# Documentation: https://docs.litellm.ai/docs/providers/anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_API_BASE=https://api.anthropic.com

# --- Google (Gemini/Vertex AI) ---
# Get your key from: https://makersuite.google.com/app/apikey
# Documentation: https://docs.litellm.ai/docs/providers/gemini
GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# VERTEXAI_PROJECT=your-project-id
# VERTEXAI_LOCATION=us-central1

# --- IBM Watsonx.ai ---
# Get credentials from: https://cloud.ibm.com/
# Documentation: https://docs.litellm.ai/docs/providers/watsonx
WATSONX_API_KEY=your-watsonx-api-key-here
WATSONX_PROJECT_ID=your-project-id-here
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_REGION=us-south

# --- Groq ---
# Get your key from: https://console.groq.com/keys
# Documentation: https://docs.litellm.ai/docs/providers/groq
GROQ_API_KEY=gsk_your_groq_key_here

# --- Azure OpenAI ---
# Get credentials from: https://portal.azure.com/
# Documentation: https://docs.litellm.ai/docs/providers/azure
AZURE_API_KEY=your-azure-api-key-here
AZURE_API_BASE=https://your-resource.openai.azure.com
AZURE_API_VERSION=2024-02-15-preview
# AZURE_AD_TOKEN=your-azure-ad-token

# --- Cohere ---
# Get your key from: https://dashboard.cohere.com/api-keys
# Documentation: https://docs.litellm.ai/docs/providers/cohere
COHERE_API_KEY=your-cohere-api-key-here

# --- Hugging Face ---
# Get your key from: https://huggingface.co/settings/tokens
# Documentation: https://docs.litellm.ai/docs/providers/huggingface
HUGGINGFACE_API_KEY=hf_your_huggingface_key_here
# HUGGINGFACE_API_BASE=https://api-inference.huggingface.co/models

# --- Replicate ---
# Get your key from: https://replicate.com/account/api-tokens
# Documentation: https://docs.litellm.ai/docs/providers/replicate
REPLICATE_API_KEY=r8_your_replicate_key_here

# ============================================================================
# Model Configuration Overrides
# ============================================================================
# Specify default models for each role (Teacher, Expansion, Heavy)
# Format: provider/model-name (e.g., ollama/granite4.1:8b, openai/gpt-4o)

TEACHER_MODEL=ollama/granite4.1:8b
EXPANSION_MODEL=ollama/granite4.1:8b
HEAVY_MODEL=ollama/granite4.1:8b

# ============================================================================
# Agent Mode Configuration
# ============================================================================
# Set to "real" to use actual NeuralToolRouter with BeeAI/LangGraph
# Set to "mock" to use simulated execution (default, no dependencies required)
AGENT_EXECUTION_MODE=mock

# ============================================================================
# Optional: Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/runtime.log

# ============================================================================
# Optional: Data Paths
# ============================================================================
DATA_DIR=./data
MODELS_DIR=./models
LOGS_DIR=./logs

# ============================================================================
# Optional: Advanced Provider Settings
# ============================================================================

# Timeout settings (in seconds)
# REQUEST_TIMEOUT=600
# CONNECT_TIMEOUT=30

# Retry settings
# MAX_RETRIES=3
# RETRY_DELAY=1

# Rate limiting
# MAX_REQUESTS_PER_MINUTE=60