# SynapseForge Environment Variables
# Copy this file to .env and fill in your values
# Reference: https://docs.litellm.ai/docs/provider_registration/

# ============================================================================
# Database, Vector Search & Cache (must match docker-compose.yml)
# ============================================================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=synapse_forge
MONGODB_USER=synapse_user
MONGODB_PASSWORD=synapse_secret_2026
MONGODB_AUTH_DATABASE=admin
# Or override with a full URL:
# MONGODB_URL=mongodb://synapse_user:synapse_secret_2026@localhost:27017/synapse_forge?authSource=admin

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=synapse_forge
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_SECURE=false

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=synapse_redis_2026
REDIS_DB=0
# Or override with a full URL:
# REDIS_URL=redis://:synapse_redis_2026@localhost:6380/0

# --- Database Reset ---
# ⚠️  WARNING: Setting DB_AUTO_RESET=true will DROP ALL MongoDB collections
# managed by SynapseForge during explicit reset flows. Keep false unless you
# intentionally want a destructive development reset.
DB_AUTO_RESET=false

# ============================================================================
# Docker Control Plane (Workspace Container Orchestration)
# ============================================================================
# Image used for workspace Data Plane containers:
# WORKSPACE_CONTAINER_IMAGE=python:3.11-slim
# Shared Docker network connecting workspace containers to DB/Redis:
# DOCKER_NETWORK_NAME=synapse-forge_default
# DB/Redis/Milvus hostnames as seen from inside the Docker network:
# WORKSPACE_DB_HOST=synapse_mongodb
# WORKSPACE_REDIS_HOST=synapse_redis
# WORKSPACE_VECTOR_HOST=synapse_milvus

# ============================================================================
# LLM Provider — Ollama (Local Development)
# ============================================================================
# SynapseForge uses workspace-scoped LLM configurations stored in the database.
# The 3 default configs (Teacher, Expansion, Heavy) are seeded with Ollama
# details during setup. Configure additional providers (OpenAI, Anthropic,
# Google, etc.) via the Settings page in the UI.
#
# For local development, only Ollama is needed (no API key required):
OLLAMA_API_BASE=http://localhost:11434

DEFAULT_AGENT_MODEL=ollama/granite4.1:8b

# ============================================================================
# Agent Mode Configuration
# ============================================================================
# Set to "real" to use actual NeuralToolRouter with BeeAI/LangGraph
# Set to "mock" to use simulated execution (default, no dependencies required)
AGENT_EXECUTION_MODE=mock

# ============================================================================
# OAuth (optional — for user authentication)
# ============================================================================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
#
# IMPORTANT: OAUTH_REDIRECT_BASE_URL must exactly match the "Authorized redirect URI"
# registered in Google Cloud Console / GitHub OAuth App settings.
# The backend appends  /api/auth/callback/{provider}  to this base.
# For local development this is typically: http://localhost:8000
# OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# ============================================================================
# Optional: Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/runtime.log

# ============================================================================
# Optional: Data Paths
# ============================================================================
DATA_DIR=./data
MODELS_DIR=./models
LOGS_DIR=./logs

# ============================================================================
# Optional: Advanced Provider Settings
# ============================================================================

# Timeout settings (in seconds)
# REQUEST_TIMEOUT=600
# CONNECT_TIMEOUT=30

# Retry settings
# MAX_RETRIES=3
# RETRY_DELAY=1

# Rate limiting
# MAX_REQUESTS_PER_MINUTE=60

# ============================================================================
# IBM Cloud Object Storage (COS) — S3-Compatible Storage for Artifacts
# ============================================================================
# SynapseForge uses IBM COS to store all pipeline artifacts (datasets, models,
# indexes) generated during Phase 1 (Generate) and Phase 2 (Train). This ensures
# artifacts are not stored locally and are accessible across workspace sessions.
#
# IMPORTANT: If COS credentials are not configured, the system will run in MOCK
# mode using local directory simulation under 'data/cos_mock'. This is suitable
# for development but NOT recommended for production.
#
# Configuration Options:
# ----------------------
# Option 1: IBM Cloud IAM API Key Authentication (Recommended)
# Get these values from your IBM Cloud Object Storage service instance:
# 1. Endpoint: Regional endpoint URL (e.g., https://s3.us-south.cloud-object-storage.appdomain.cloud)
# 2. API Key: IAM API key with access to your COS instance
# 3. Service Instance ID: CRN of your COS service instance
# 4. Bucket Name: Name of the bucket to store artifacts (will be created if it doesn't exist)
#
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_API_KEY_ID=your-ibm-cos-api-key
IBM_COS_SERVICE_INSTANCE_ID=crn:v1:bluemix:public:cloud-object-storage:global:a/your-account-id:your-service-instance-id::
IBM_COS_BUCKET_NAME=synapse-forge

# Option 2: S3-Compatible HMAC Access Key Authentication (Alternative)
# Use this if you prefer HMAC credentials instead of IAM authentication:
# IBM_COS_ACCESS_KEY_ID=your-hmac-access-key-id
# IBM_COS_SECRET_ACCESS_KEY=your-hmac-secret-access-key
#
# Note: When using HMAC, you still need to set IBM_COS_ENDPOINT and IBM_COS_BUCKET_NAME
#
# Artifact Storage Structure:
# ---------------------------
# All artifacts are stored under workspace-scoped prefixes:
# - workspaces/{workspace_id}/generate/dataset/synthetic_queries.jsonl
# - workspaces/{workspace_id}/generate/tool_cache/tool_cache.json
# - workspaces/{workspace_id}/train/fine_tuned_model/...
# - workspaces/{workspace_id}/train/faiss_index/faiss_index.bin
# - workspaces/{workspace_id}/train/bm25_index/bm25_index.pkl